MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=buddies_db
# Set your own values in .env.local (never commit credentials).
JWT_SECRET=
ADMIN_PASSWORD=

# Public website origin; required when deployed behind a reverse proxy.
# APP_ORIGIN=https://your-domain.com
# Set this to a durable directory on the hosting server.
# UPLOAD_DIR=/data/buddies/uploads
# Cashfree checkout. Enable after configuring sandbox credentials and webhooks.
RENTAL_PAYMENT_PROVIDER=pickup
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Customer passwordless OTP login (server only).
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=KKWMRT
FAST2SMS_MESSAGE_ID=225363
# Entity is linked to the sender/template in Fast2SMS DLT Manager, not sent on route=dlt.
FAST2SMS_ENTITY_ID=1701178919125969252
# Exact template variable order, e.g. {otp} for a single OTP variable.
FAST2SMS_OTP_VARIABLES=
# Generate an independent random secret, at least 32 characters.
OTP_SECRET=

# Admin WhatsApp booking confirmation notifications (server only).
WABA_NOTIFICATIONS_ENABLED=false
WABA_API_BASE=https://waba.kkwebmart.in/api/v1
WABA_API_KEY=
WABA_ADMIN_PHONE=916001263561
WABA_BOOKING_TEMPLATE=buddies_booking_confirmed
WABA_TEMPLATE_LANGUAGE=en_US
